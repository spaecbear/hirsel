# Copy to ids.env and fill in from the Steamworks partner site once the apps exist.
# App Admin → your app → SteamPipe → Depots lists the depot ids.

# the game
HIRSEL_APP_ID=
HIRSEL_WIN_DEPOT=
HIRSEL_LINUX_DEPOT=

# the demo: its own app, created under the game's
HIRSEL_DEMO_APP_ID=
HIRSEL_DEMO_WIN_DEPOT=
HIRSEL_DEMO_LINUX_DEPOT=
